generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String             @id @default(uuid())
  name       String
  email      String             @unique
  password   String
  roleId     String
  createdAt  DateTime           @default(now())
  activities EmployeeActivity[]
  role       Role               @relation(fields: [roleId], references: [id])
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
}

model Livestock {
  id            String                  @id @default(uuid())
  livestockCode String                  @unique
  name          String
  type          String
  breed         String
  gender        String
  birthDate     DateTime
  initialWeight Float
  currentWeight Float
  status        String
  imageUrl      String?
  createdAt     DateTime                @default(now())
  feedUsages    FeedUsage[]
  activities    LivestockActivity[]
  healthRecords LivestockHealthRecord[]
  vaccines      LivestockVaccine[]
  weights       LivestockWeight[]
}

model LivestockWeight {
  id          String    @id @default(uuid())
  weight      Float
  recordedAt  DateTime  @default(now())
  livestockId String
  livestock   Livestock @relation(fields: [livestockId], references: [id])
}

model FeedItem {
  id           String       @id @default(uuid())
  name         String
  stock        Float
  unit         String
  minimumStock Float
  categoryId   String
  createdAt    DateTime     @default(now())
  category     FeedCategory @relation(fields: [categoryId], references: [id])
  usage        FeedUsage[]
}

model FeedCategory {
  id    String     @id @default(uuid())
  name  String     @unique
  items FeedItem[]
}

model FeedUsage {
  id          String    @id @default(uuid())
  quantity    Float
  date        DateTime  @default(now())
  livestockId String
  feedItemId  String
  feedItem    FeedItem  @relation(fields: [feedItemId], references: [id])
  livestock   Livestock @relation(fields: [livestockId], references: [id])
}

model LivestockHealthRecord {
  id          String    @id @default(uuid())
  disease     String
  symptom     String
  treatment   String
  medicine    String
  livestockId String
  createdAt   DateTime  @default(now())
  livestock   Livestock @relation(fields: [livestockId], references: [id])
}

model Vaccine {
  id        String             @id @default(uuid())
  name      String
  livestock LivestockVaccine[]
}

model LivestockVaccine {
  id          String    @id @default(uuid())
  scheduledAt DateTime
  givenAt     DateTime?
  livestockId String
  vaccineId   String
  livestock   Livestock @relation(fields: [livestockId], references: [id])
  vaccine     Vaccine   @relation(fields: [vaccineId], references: [id])
}

model FinancialTransaction {
  id              String            @id @default(uuid())
  amount          Float
  type            String
  description     String
  transactionDate DateTime          @default(now())
  categoryId      String
  category        FinancialCategory @relation(fields: [categoryId], references: [id])
}

model FinancialCategory {
  id           String                 @id @default(uuid())
  name         String
  type         String
  transactions FinancialTransaction[]
}

model InventoryItem {
  id        String   @id @default(uuid())
  name      String
  stock     Float
  unit      String
  type      String
  createdAt DateTime @default(now())
}

model EmployeeActivity {
  id        String   @id @default(uuid())
  action    String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model LivestockActivity {
  id          String    @id @default(uuid())
  description String
  livestockId String
  createdAt   DateTime  @default(now())
  livestock   Livestock @relation(fields: [livestockId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
